{
  "name": "@oox-marketplace/sdk",
  "version": "0.1.1",
  "description": "Buy and list NFTs on the OOX marketplace (MultiversX) from any dapp",
  "license": "MIT",
  "author": "OnionXLabs",
  "homepage": "https://oox.art",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paix/oox-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Paix/oox-sdk/issues"
  },
  "keywords": [
    "multiversx",
    "nft",
    "marketplace",
    "oox",
    "sdk",
    "egld"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@multiversx/sdk-core": "^15.0.0"
  },
  "devDependencies": {
    "@multiversx/sdk-core": "^15.4.1",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
